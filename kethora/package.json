{
  "name": "kethora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "test": "npm run build && node --test dist/tests/unit/*.test.js dist/tests/contract/*.test.js dist/tests/fault/*.test.js",
    "dev:api": "node --env-file-if-exists=.env dist/services/api/src/server.js",
    "migrate": "node dist/db/migrate.js",
    "receipt": "node scripts/receipt.mjs",
    "dev": "npm run build && npm run dev:api",
    "start": "node --env-file-if-exists=.env dist/services/api/src/server.js",
    "test:e2e": "playwright test",
    "check": "npm test && npm run test:e2e",
    "test:infra": "node tests/integration/infrastructure.mjs",
    "dev:workflow": "node --env-file-if-exists=.env dist/services/workflow/src/worker.js"
  },
  "dependencies": {
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "pdfkit": "0.17.2",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@types/node": "24.9.0",
    "@types/pdfkit": "0.17.3",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
