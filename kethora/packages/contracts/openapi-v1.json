  "components": {
    "securitySchemes": {
      "AccountSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-kethora-session",
        "description": "Secure HttpOnly SameSite cookie on trusted web host; iOS device refresh uses separate protected flow"
      }
    },
    "schemas": {
      "Command": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command_id",
          "kind",
          "text",
          "attachments"
        ],
        "properties": {
          "command_id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "enum": [
              "create",
              "revise",
              "pause",
              "resume",
              "cancel",
              "discussion"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 4000
          },
          "attachments": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "target_id": {
            "type": "string",
            "format": "uuid"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "TaskContract": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "outcome",
          "sources",
          "acceptance",
          "allowed_operations",
          "cost_ceiling_usd",
          "deadline_at",
          "task_revision"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "outcome": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object"
            }
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "allowed_operations": {
            "type": "array",
            "items": {
              "enum": [
                "public_source_read",
                "artifact_create",
                "calendar_event_create_after_approval"
              ]
            }
          },
          "cost_ceiling_usd": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,2})?$"
          },
          "deadline_at": {
            "type": "string",
            "format": "date-time"
          },
          "task_revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Waiting": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason",
          "responsible_party",
          "resume_condition",
          "entered_at"
        ],
        "properties": {
          "reason": {
            "enum": [
              "approval",
              "input",
              "authentication",
              "provider",
              "device",
              "budget",
              "capacity"
            ]
          },
          "responsible_party": {
            "enum": [
              "user",
              "provider",
              "operator",
              "system"
            ]
          },
          "resume_condition": {
            "type": "string"
          },
          "entered_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ApprovalDecision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision",
          "shown_digest",
          "step_up_proof"
        ],
        "properties": {
          "decision": {
            "enum": [
              "approve",
              "deny"
            ]
          },
          "shown_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "step_up_proof": {
            "type": "string"
          }
        }
      },
      "TaskRevision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected_revision"
        ],
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "Error429": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "operation",
          "retry_after_seconds",
          "limit_scope",
          "request_id"
        ],
        "properties": {
          "code": {
            "const": "rate_limited"
          },
          "operation": {
            "type": "string"
          },
          "retry_after_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "limit_scope": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ArtifactStage": {
        "type": "object",
        "description": "G0 contract placeholder; must be frozen and typed before this endpoint is enabled",
        "additionalProperties": false,
        "properties": {}
      },
      "ArtifactCommit": {
        "type": "object",
        "description": "G0 contract placeholder; must be frozen and typed before this endpoint is enabled",
        "additionalProperties": false,
        "properties": {}
      },
      "MemoryEdit": {
        "type": "object",
        "description": "G0 contract placeholder; must be frozen and typed before this endpoint is enabled",
        "additionalProperties": false,
        "properties": {}
      },
      "GoalCreate": {
        "type": "object",
        "description": "G0 contract placeholder; must be frozen and typed before this endpoint is enabled",
        "additionalProperties": false,
        "properties": {}
      },
      "MonitorCreate": {
        "type": "object",
        "description": "G0 contract placeholder; must be frozen and typed before this endpoint is enabled",
        "additionalProperties": false,
        "properties": {}
      },
      "ConnectionCreate": {
        "type": "object",
        "description": "G0 contract placeholder; must be frozen and typed before this endpoint is enabled",
        "additionalProperties": false,
        "properties": {}
      }
    }
  }
