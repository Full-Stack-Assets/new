# Local edition only; never commit .env or copy this service to a public origin.
PORT=8787
KETHORA_LOCAL_DB=data/local.sqlite
# Optional NVIDIA integration. Both must be set; the app separately requires consent.
NVIDIA_API_KEY=
NVIDIA_MODEL=
# Production seams use separate least-privilege identities, never these local values.
# KETHORA_WORKFLOW_DATABASE_URL=
# KETHORA_TEMPORAL_ADDRESS=127.0.0.1:7233
# KETHORA_WORKER_BUILD_ID=
